 "analysis": [
  {
   "label": "Context",
   "text": "England led 2–0 and Norway were defending their box in numbers. With everyone waiting for a cross, the space in front of the penalty area was unguarded."
  },
  {
   "label": "The routine",
   "text": "Instead of delivering into the crowd, Mead worked it short and laid the ball into the path of a runner arriving from deep."
  },
  {
   "label": "The strike",
   "text": "Bronze hit it first time with the right foot, striking through the ball rather than under it, from about eighteen metres."
  },
  {
   "label": "Why it worked",
   "text": "Every Norwegian defender had turned to watch for a cross into the six-yard box. Nobody stepped out to the edge of the area, and the shot was already gone by the time anyone moved."
  }
 ],
 "lessons": [
  {
   "label": "Work it short",
   "text": "A short set piece drags one defender out and turns a crowded box into a clear shooting lane at the edge."
  },
  {
   "label": "Arrive, don't wait",
   "text": "Running onto the ball from deep means the shot is struck at pace, and the defence has nobody assigned to you."
  },
  {
   "label": "Strike through it",
   "text": "Hitting through the middle of the ball with a firm ankle keeps a first-time shot from ballooning, even at full power."
  },
  {
   "label": "Full-backs score too",
   "text": "The chance fell to a defender arriving late. Defenders who follow the attack in are the ones nobody counts."
  }
 ],
 "note": "The ball's path, its timing and the tracked players come from StatsBomb's open data for this match (id 69199). Players the data only sees at the shot have routes drawn back into those positions, and any extra team-mates are placed by hand. Commentary is original, not the broadcast."
