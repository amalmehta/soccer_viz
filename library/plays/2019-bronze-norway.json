  {
   "t": 0,
   "text": "57' — England lead Norway 2–0 in the quarter-final."
  },
  {
   "t": 0.9,
   "text": "Mead plays it short instead of crossing."
  },
  {
   "t": 1.8,
   "text": "Bronze runs onto it, 18 metres out."
  },
  {
   "t": 2.5,
   "text": "Right foot, first time, into the roof of the net."
  }
 ],
 "commentary": [
  {
   "t": 0.0,
   "text": "England two up in Le Havre."
  },
  {
   "t": 0.9,
   "text": "Worked short, and rolled back…"
  },
  {
   "t": 1.8,
   "text": "…Bronze, first time!"
  },
  {
   "t": 2.6,
   "text": "OH, WHAT A STRIKE! Roof of the net!"
  },
  {
   "t": 5.0,
   "text": "Three-nil, and that is the tie."
  }
