  "commentary": [
    {
      "t": 0.5,
      "text": "Argentina in no hurry at all, just moving it along."
    },
    {
      "t": 4.1,
      "text": "Mascherano… Riquelme… it's like watching a training drill."
    },
    {
      "t": 8.1,
      "text": "Out wide to Maxi Rodríguez, and back inside again."
    },
    {
      "t": 12.2,
      "text": "Sorín pushing on down the left. Still nobody can win it back."
    },
    {
      "t": 15.7,
      "text": "Riquelme slips it to Saviola in the area…"
    },
    {
      "t": 17.7,
      "text": "Back to Cambiasso… into Crespo…"
    },
    {
      "t": 19.1,
      "text": "Backheel! Cambiasso's in—"
    },
    {
      "t": 19.9,
      "text": "GOAL! Oh, that is magnificent! Argentina two, Serbia and Montenegro nil!"
    },
    {
      "t": 21.3,
      "text": "Pass after pass after pass, and a finish to match."
    }
