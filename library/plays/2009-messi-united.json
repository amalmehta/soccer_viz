  "analysis": [
    {
      "label": "Context",
      "text": "Barcelona led 1–0 through Eto'o and had controlled the final. United had pushed their full-backs high looking for a way back, leaving the far side of the penalty area thin."
    },
    {
      "label": "Build-up",
      "text": "Barcelona worked it patiently along the right through Puyol, Eto'o and Xavi until the cross could be delivered from wide rather than forced through the middle."
    },
    {
      "label": "The delivery",
      "text": "Xavi did not drive it in low. The ball was lifted and hung towards the far side of the six-yard box, away from the defenders watching the ball at the near post."
    },
    {
      "label": "The header",
      "text": "Messi started the run late and jumped early, meeting the ball at its highest point above Ferdinand. The header went back across the goal, the way the ball had come, and looped over Van der Sar."
    }
  ],
  "lessons": [
    {
      "label": "Hang it to the far side",
      "text": "A high cross to the far post beats a low one when the box is crowded: the defenders' eyes are on the ball at the near post and nobody tracks the late runner."
    },
    {
      "label": "Start late, jump early",
      "text": "Messi arrives after the defenders have set their position. Timing the jump beats standing in the spot and waiting to be marked."
    },
    {
      "label": "Head it back across",
      "text": "Directing a header against the flight sends it away from the keeper's momentum, into the part of the goal nobody can cover."
    },
    {
      "label": "Height is not everything",
      "text": "The smallest player on the pitch won that header because the run and the timing were better, not because of reach."
    }
  ],
