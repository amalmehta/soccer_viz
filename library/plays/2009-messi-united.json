  "captions": [
    {
      "t": 0,
      "text": "70' — Barcelona lead 1–0 in the final."
    },
    {
      "t": 5.3,
      "text": "Puyol and Eto'o keep it on the right."
    },
    {
      "t": 10.7,
      "text": "Xavi takes it to the touchline."
    },
    {
      "t": 13.7,
      "text": "The cross hangs up towards the far side."
    },
    {
      "t": 15.2,
      "text": "Messi climbs above the defence."
    },
    {
      "t": 16.2,
      "text": "Headed back over Van der Sar. 2–0."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Seventy minutes in Rome, Barcelona a goal up and United needing something."
    },
    {
      "t": 5.3,
      "text": "Puyol, into Eto'o, back to Puyol on the right…"
    },
    {
      "t": 10.7,
      "text": "…Xavi has it wide, looking up."
    },
    {
      "t": 13.7,
      "text": "The cross is hung towards the far post…"
    },
    {
      "t": 15.2,
      "text": "…MESSI! Up above them all!"
    },
    {
      "t": 16.22,
      "text": "Headed back over the keeper — two-nil, and that is the trophy."
    },
    {
      "t": 17.6,
      "text": "The smallest player on the pitch, winning it in the air."
    }
  ],
