  "captions": [
    {
      "t": 0,
      "text": "88' — Chelsea trail 1–0 with the final slipping away."
    },
    {
      "t": 0.9,
      "text": "Mata's corner from the left."
    },
    {
      "t": 1.5,
      "text": "Drogba attacks it in front of the marker."
    },
    {
      "t": 2.4,
      "text": "Headed back across Neuer. 1–1."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Eighty-eight minutes in Munich, Chelsea a goal down, and this is the corner."
    },
    {
      "t": 0.9,
      "text": "Mata swings it in from the left…"
    },
    {
      "t": 1.5,
      "text": "…DROGBA! Powered in!"
    },
    {
      "t": 2.6,
      "text": "One apiece! From nowhere, Chelsea are level in a European Cup final."
    },
    {
      "t": 4.2,
      "text": "Their first corner of the night, and it has saved them."
    }
  ],
