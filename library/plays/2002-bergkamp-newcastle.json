  "commentary": [
    {
      "t": 0,
      "text": "Arsenal on the move early here, Pires with the ball on the left."
    },
    {
      "t": 2.6,
      "text": "Bergkamp showing for it, Dabizas tight up behind."
    },
    {
      "t": 4,
      "text": "Pires plays it in, firm and low…"
    },
    {
      "t": 4.8,
      "text": "Bergkamp — oh, the flick!"
    },
    {
      "t": 5.6,
      "text": "Bergkamp's gone one way, the ball's gone the other!"
    },
    {
      "t": 6.9,
      "text": "Clean through on Given…"
    },
    {
      "t": 7.7,
      "text": "AND IT'S IN! That is pure genius from Bergkamp!"
    },
    {
      "t": 9.1,
      "text": "Dabizas still trying to work out where Bergkamp went. Sensational."
    }
