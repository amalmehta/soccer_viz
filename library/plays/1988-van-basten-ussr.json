  "captions": [
    {"t":0,"text":"54' — the Netherlands lead the USSR 1–0 in the final."},
    {"t":2.2,"text":"The ball is worked out to Arnold Mühren on the left."},
    {"t":6.2,"text":"Mühren loops a high ball over to the far side of the box."},
    {"t":7.4,"text":"Van Basten is out wide, level with the six-yard box."},
    {"t":8.4,"text":"No touch to control it: a volley from a very tight angle."},
    {"t":9.15,"text":"Over Dasayev and into the far top corner. 2–0."}
