  "captions": [
    {
      "t": 0,
      "text": "64' — level at 1–1, three minutes after Bale came on."
    },
    {
      "t": 3.5,
      "text": "Madrid work it across: Modrić, Casemiro, Kroos."
    },
    {
      "t": 6.6,
      "text": "Ronaldo carries it forward on the left."
    },
    {
      "t": 13.0,
      "text": "Back inside to Casemiro, then wide to Marcelo."
    },
    {
      "t": 18.7,
      "text": "Marcelo's cross drops behind Bale."
    },
    {
      "t": 19.8,
      "text": "Bale turns away from goal and hooks it overhead."
    },
    {
      "t": 21.0,
      "text": "Top corner. Real Madrid 2–1 Liverpool."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Sixty-four minutes in Kyiv, one apiece, and Madrid have it again."
    },
    {
      "t": 3.4,
      "text": "Modrić, into Casemiro, out to Kroos — no rush from Madrid."
    },
    {
      "t": 6.6,
      "text": "Ronaldo takes it down the left…"
    },
    {
      "t": 13.0,
      "text": "…back inside to Casemiro, and out to Marcelo on the far side."
    },
    {
      "t": 18.6,
      "text": "The cross is in, and it's dropping behind Bale…"
    },
    {
      "t": 19.8,
      "text": "…Bale, overhead kick!"
    },
    {
      "t": 20.89,
      "text": "OH, THAT IS MAGNIFICENT! Into the top corner!"
    },
    {
      "t": 22.2,
      "text": "Three minutes on the pitch, and the substitute has settled the final."
    }
  ],
