  "commentary": [
    {
      "t": 0,
      "text": "A cagey opening to this one at the Maracanã."
    },
    {
      "t": 2.2,
      "text": "Colombia looking for a way through, out to the left."
    },
    {
      "t": 4.2,
      "text": "Hoisted towards the edge of the area…"
    },
    {
      "t": 6.2,
      "text": "Aguilar nods it back…"
    },
    {
      "t": 6.8,
      "text": "James, on the chest, twenty-odd metres out…"
    },
    {
      "t": 7.5,
      "text": "James has hit it on the turn!"
    },
    {
      "t": 8.45,
      "text": "OFF THE BAR AND IN! What a strike from James Rodríguez!"
    },
    {
      "t": 9.8,
      "text": "Chest, swivel, volley. James never let it touch the grass."
    }
  ],
