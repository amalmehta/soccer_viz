  "captions": [
    {
      "t": 0,
      "text": "28' — 0–0 at the Maracanã in the round of 16."
    },
    {
      "t": 2.2,
      "text": "Colombia work it out to the left."
    },
    {
      "t": 4.2,
      "text": "A long ball towards the edge of Uruguay's box."
    },
    {
      "t": 6.2,
      "text": "Aguilar heads it down into James's path."
    },
    {
      "t": 6.8,
      "text": "James takes it on the chest and turns…"
    },
    {
      "t": 7.5,
      "text": "…and volleys it before it lands, from outside the box."
    },
    {
      "t": 8.45,
      "text": "Down off the crossbar and in. Colombia 1–0 Uruguay."
    }
