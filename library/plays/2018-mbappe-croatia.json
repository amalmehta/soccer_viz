  "captions": [
    {
      "t": 0,
      "text": "65' — France lead 3–1 in the final."
    },
    {
      "t": 3.2,
      "text": "France keep it: Matuidi, Pogba, Nzonzi."
    },
    {
      "t": 10.1,
      "text": "Hernández carries it forward on the left."
    },
    {
      "t": 17.8,
      "text": "It comes to Mbappé, 25 metres out."
    },
    {
      "t": 19.4,
      "text": "Right foot, low, almost no backlift."
    },
    {
      "t": 20.4,
      "text": "Into the corner. France 4–1 Croatia."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Sixty-five minutes in Moscow, France three-one up, and Croatia are chasing shadows."
    },
    {
      "t": 3.2,
      "text": "Matuidi, Pogba, Nzonzi — France in no hurry at all."
    },
    {
      "t": 10.1,
      "text": "Hernández takes it forward on the left…"
    },
    {
      "t": 17.8,
      "text": "…and it's rolled to Mbappé, twenty-five yards out."
    },
    {
      "t": 19.4,
      "text": "Mbappé, first time…"
    },
    {
      "t": 20.36,
      "text": "…IN! Low into the corner, and that is four!"
    },
    {
      "t": 21.8,
      "text": "Nineteen years old, scoring in a World Cup final."
    }
  ],
