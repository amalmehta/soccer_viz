  "analysis": [
    {
      "label": "Context",
      "text": "A tight, bruising final was 0–0 deep into extra time, and the Netherlands were down to ten men after Heitinga's second yellow. Penalties were four minutes away."
    },
    {
      "label": "Build-up",
      "text": "Navas's run stretched a tiring Dutch side and pushed them back towards their own box. Torres's delivery from the left was cut out by van der Vaart, but the clearance only went as far as Fàbregas."
    },
    {
      "label": "Key moment",
      "text": "With the Dutch shape broken by the block and the loose ball, Fàbregas found Iniesta on the right of the box before the defence could reset."
    },
    {
      "label": "The finish",
      "text": "Iniesta took one touch to set the ball, then hit it with the right foot before a defender could close. Struck quickly after the set-up touch, it left Stekelenburg little time to react."
    }
  ]
