    {
      "t": 0,
      "text": "116' of the final. 0–0, and the Netherlands are down to ten."
    },
    {
      "t": 1.2,
      "text": "Navas carries Spain forward at speed."
    },
    {
      "t": 4.2,
      "text": "The ball is worked out to Torres on the left."
    },
    {
      "t": 5.8,
      "text": "Torres's cross is cut out by van der Vaart…"
    },
    {
      "t": 6.9,
      "text": "…but only as far as Fàbregas."
    },
    {
      "t": 7.5,
      "text": "Fàbregas slips it into Iniesta on the right of the box."
    },
    {
      "t": 8.7,
      "text": "A touch to set it, then a right-foot shot."
    },
    {
      "t": 9.25,
      "text": "Past Stekelenburg. Spain lead 1–0 in the final."
    }
