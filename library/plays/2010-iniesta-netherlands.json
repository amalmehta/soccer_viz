  "commentary": [
    {
      "t": 0,
      "text": "Four minutes of extra time left, and penalties are looming…"
    },
    {
      "t": 1.2,
      "text": "Navas surges forward for Spain."
    },
    {
      "t": 4.2,
      "text": "Torres on the left, looking to deliver…"
    },
    {
      "t": 6.3,
      "text": "Blocked by van der Vaart! It falls to Fàbregas…"
    },
    {
      "t": 7.5,
      "text": "Fàbregas finds Iniesta—"
    },
    {
      "t": 8.7,
      "text": "Iniesta!"
    },
    {
      "t": 9.25,
      "text": "IT'S IN! Iniesta, with four minutes left! Spain are almost there!"
    },
    {
      "t": 10.8,
      "text": "A whole country on its feet. Can they hold on now?"
    }
