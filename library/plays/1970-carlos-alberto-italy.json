  "captions": [
    {
      "t": 0,
      "text": "86' — Brazil lead Italy 3–1 in the World Cup final."
    },
    {
      "t": 1.5,
      "text": "Clodoaldo slips past a string of Italians inside the Brazil half."
    },
    {
      "t": 5.5,
      "text": "Out to Rivellino, who sends it down the left."
    },
    {
      "t": 8.9,
      "text": "Jairzinho cuts inside, with Facchetti following close behind."
    },
    {
      "t": 12.5,
      "text": "Into Pelé at the edge of the box…"
    },
    {
      "t": 15.75,
      "text": "…who rolls it right, into the path of Carlos Alberto."
    },
    {
      "t": 16.6,
      "text": "First time, low and hard, past Albertosi."
    },
    {
      "t": 17.8,
      "text": "Brazil 4–1 Italy. A third world title is sealed."
    }
