  "captions": [
    {
      "t": 0,
      "text": "86' — Brazil lead Italy 3–1 in the final."
    },
    {
      "t": 2.1,
      "text": "Clodoaldo takes it deep in the Brazil half and goes past four."
    },
    {
      "t": 9.1,
      "text": "Out to Rivelino on the left."
    },
    {
      "t": 12.5,
      "text": "Rivelino's long ball drops for Jairzinho."
    },
    {
      "t": 18.5,
      "text": "Jairzinho cuts inside to Pelé, who slows it all down."
    },
    {
      "t": 20.2,
      "text": "Pelé waits… and rolls it right."
    },
    {
      "t": 22.0,
      "text": "Carlos Alberto arrives at full speed and hits it first time."
    },
    {
      "t": 23.5,
      "text": "Brazil 4–1 Italy."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Eighty-six minutes in the Azteca, Brazil three-one up and in no hurry at all."
    },
    {
      "t": 2.1,
      "text": "Clodoaldo, deep in the Brazil half — and that's one, two, three, four Italians beaten!"
    },
    {
      "t": 9.1,
      "text": "Out to the left, Rivelino…"
    },
    {
      "t": 12.5,
      "text": "…and a long one down the line for Jairzinho."
    },
    {
      "t": 18.5,
      "text": "Inside to Pelé, and everything goes quiet."
    },
    {
      "t": 20.4,
      "text": "Pelé holds it… holds it…"
    },
    {
      "t": 22.0,
      "text": "…rolled right, and here comes the captain!"
    },
    {
      "t": 22.79,
      "text": "Carlos Alberto, first time — into the corner! Four-one!"
    },
    {
      "t": 24.2,
      "text": "Eight players touched that move. The perfect goal to finish a final."
    }
  ],
