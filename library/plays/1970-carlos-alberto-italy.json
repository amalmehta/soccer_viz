  "analysis": [
    {
      "label": "Context",
      "text": "Brazil led 3–1 with minutes left, so Italy had to push forward. The gaps behind their midfield let Brazil keep the ball and build from deep without being pressed."
    },
    {
      "label": "Build-up",
      "text": "Clodoaldo's dribble through four Italians inside the Brazil half drew the defence towards the ball. The move then went left through Rivelino to Jairzinho, away from the crowd."
    },
    {
      "label": "Key moment",
      "text": "Jairzinho came inside from the left, and Italy's cover followed the ball. That left Brazil's right flank empty — the lane Carlos Alberto had been running into all move."
    },
    {
      "label": "The finish",
      "text": "Pelé held the ball at the edge of the box to freeze the defence, then rolled it into the captain's stride. Carlos Alberto struck it first time, low and hard, before Albertosi could set."
    }
  ],
  "lessons": [
    {
      "label": "Switch the play",
      "text": "Moving the ball from one flank to the other makes a set defence shuffle across. Each switch pulls someone a step out of line, and the space opens on the side the ball just left."
    },
    {
      "label": "Overlap from deep",
      "text": "Carlos Alberto starts the move as a full-back in the Brazil half. A defender arriving late at full speed is the hardest runner to pick up, because nobody has been marking that player."
    },
    {
      "label": "Hold it to freeze them",
      "text": "Pelé pauses on the ball at the edge of the box, which holds the defenders still. A short pause before the pass is often worth more than a quicker one."
    },
    {
      "label": "Pass into the stride",
      "text": "The ball is rolled ahead of the runner, not to the feet, so the shot can be struck first time before the keeper sets."
    }
  ],
