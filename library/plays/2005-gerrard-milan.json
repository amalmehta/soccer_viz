  "captions": [
    {
      "t": 0,
      "text": "54' — Liverpool are 3–0 down in the final."
    },
    {
      "t": 3.8,
      "text": "Alonso and Hamann keep the ball moving."
    },
    {
      "t": 11.5,
      "text": "Riise crosses from the left — blocked."
    },
    {
      "t": 14.0,
      "text": "Riise wins it back and crosses again."
    },
    {
      "t": 17.0,
      "text": "Gerrard arrives from midfield and heads it back across Dida."
    },
    {
      "t": 18.5,
      "text": "3–1. Liverpool are alive."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Just before the hour in Istanbul, and Liverpool are three down in a European Cup final."
    },
    {
      "t": 3.8,
      "text": "Alonso, Hamann, back to Alonso — Liverpool keeping it at last."
    },
    {
      "t": 11.5,
      "text": "Riise, the cross… blocked."
    },
    {
      "t": 14.0,
      "text": "But Riise has it again, and this one is in…"
    },
    {
      "t": 17.0,
      "text": "…GERRARD! Up above them all, and it's back across the goalkeeper!"
    },
    {
      "t": 18.4,
      "text": "Three-one! The captain has given Liverpool something to hold on to."
    },
    {
      "t": 20.0,
      "text": "Six minutes later it would be three apiece."
    }
  ],
