  "analysis": [
    {
      "label": "Context",
      "text": "Liverpool were 3–0 down at half-time in the final. The second half began with more of the ball, but nothing had come from it until the attack went down the left."
    },
    {
      "label": "Persistence",
      "text": "Riise's first cross was blocked. The ball came straight back to the same player, and rather than restarting the move, Riise crossed again before Milan's defence had reset."
    },
    {
      "label": "The run",
      "text": "Gerrard attacked from midfield rather than from the forward line, arriving at the far side of the six-yard box where Milan's centre-backs were watching the strikers instead."
    },
    {
      "label": "The header",
      "text": "The header went back across the goal, the direction the ball had come from. Dida was moving towards the near post and could not change direction in time."
    }
  ],
  "lessons": [
    {
      "label": "Cross it again",
      "text": "A blocked cross is not the end of the attack. Winning the ball back and delivering immediately attacks a defence that is still re-forming."
    },
    {
      "label": "Arrive from midfield",
      "text": "Gerrard starts the move deep and enters the box late. Defenders watching the strikers rarely pick up the runner coming from behind them."
    },
    {
      "label": "Head it back across",
      "text": "Directing a header away from the side the cross came from sends it against the keeper's momentum and into the part of the goal nobody is covering."
    },
    {
      "label": "Attack the far post",
      "text": "The far side of the six-yard box is the least defended space in the box, because everyone else is drawn to the ball."
    }
  ],
