 "captions": [
  {
   "t": 0,
   "text": "36' — Argentina lead 1–0 and France can't get out."
  },
  {
   "t": 2.4,
   "text": "Mbappé loses it deep in the Argentina half."
  },
  {
   "t": 9.4,
   "text": "Upamecano's clearance only reaches Molina."
  },
  {
   "t": 12.5,
   "text": "Mac Allister carries it, then Messi moves it on first time."
  },
  {
   "t": 15.4,
   "text": "Álvarez takes it wide of the last defender."
  },
  {
   "t": 19.1,
   "text": "Mac Allister arrives on the overlap and squares it."
  },
  {
   "t": 20.8,
   "text": "Di María, alone at the far post, finishes first time."
  },
  {
   "t": 21.9,
   "text": "Argentina 2–0 France."
  }
 ],
 "commentary": [
  {
   "t": 0,
   "text": "Thirty-six minutes in Lusail, Argentina a goal up and France yet to settle."
  },
  {
   "t": 2.4,
   "text": "Mbappé is dispossessed, and Argentina have it back…"
  },
  {
   "t": 9.4,
   "text": "The clearance drops to Molina, and Argentina go again."
  },
  {
   "t": 12.5,
   "text": "Mac Allister drives forward, into Messi…"
  },
  {
   "t": 15.4,
   "text": "…first time to Álvarez, and Argentina are through the middle!"
  },
  {
   "t": 19.1,
   "text": "Mac Allister, overlapping, squares it…"
  },
  {
   "t": 20.8,
   "text": "…DI MARÍA! First time, and it's two!"
  },
  {
   "t": 22.4,
   "text": "Four passes from their own third to the France net. Ruthless."
  }
 ],
