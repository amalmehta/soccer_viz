 "analysis": [
  {
   "label": "Context",
   "text": "Argentina led 1–0 and France had barely strung two passes together. When Mbappé was dispossessed deep in the Argentina half, France were caught with players committed and no shape to fall back into."
  },
  {
   "label": "The turnover",
   "text": "Argentina went forward the moment they won it. From Molina's ball to the finish there are four passes, and none of them go backwards: the counter arrives before the French midfield can turn and run."
  },
  {
   "label": "The break",
   "text": "Mac Allister carried into the space Mbappé had left, Messi moved it on first time rather than taking a touch, and Álvarez released Mac Allister wide of the last defender."
  },
  {
   "label": "The finish",
   "text": "Di María had drifted to the far post, with no defender tracking that run. The square ball came across the six-yard box and the finish was first time, past Lloris before the keeper could reset."
  }
 ],
 "lessons": [
  {
   "label": "Go at once",
   "text": "Argentina attack the moment they win the ball, while France still have players ahead of it. A counter delayed by one extra touch usually meets a reorganised defence."
  },
  {
   "label": "Pass, don't dwell",
   "text": "Messi takes no touch to control it. Every first-time pass on a counter is time the recovering defenders don't get."
  },
  {
   "label": "Run past the ball",
   "text": "Mac Allister passes and keeps going, arriving wide of the last defender. A midfielder running beyond the attack is the hardest runner to pick up."
  },
  {
   "label": "Wait at the far post",
   "text": "Di María stays on the far side, out of the defenders' eyeline. Balls across the six-yard box find whoever held that run."
  }
 ],
 "note": "The ball's path, its timing and the tracked players come from StatsBomb's open data for this match (id 3869685). Players the data only sees at the shot have hand-drawn routes into those positions, and the rest of both teams are placed by hand. Commentary is original, not the broadcast.",
 "stake": "Argentina have not won it since 1986, and this is Messi's last World Cup.",
 "aftermath": "Two–nil, and France had barely touched it. Forty-five minutes later it was two–all."
}
