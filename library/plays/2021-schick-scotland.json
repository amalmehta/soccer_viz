  "captions": [
    {
      "t": 0,
      "text": "52' — the Czechs lead 1–0 at Hampden."
    },
    {
      "t": 3.5,
      "text": "Scotland try to play out through Armstrong."
    },
    {
      "t": 8.7,
      "text": "Hendry's clearance is headed back into Czech territory."
    },
    {
      "t": 13.6,
      "text": "Schick takes it down just inside the Scotland half."
    },
    {
      "t": 14.4,
      "text": "Marshall is a long way off the line."
    },
    {
      "t": 16.2,
      "text": "From 45 metres — over the keeper and in."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Just after the hour at Hampden, the Czechs a goal up and Scotland pressing."
    },
    {
      "t": 3.5,
      "text": "Scotland work it out through Armstrong…"
    },
    {
      "t": 8.7,
      "text": "…and the clearance is headed straight back upfield."
    },
    {
      "t": 13.6,
      "text": "Schick, inside the Scotland half, looks up…"
    },
    {
      "t": 15.0,
      "text": "…and Schick is going to try it from here!"
    },
    {
      "t": 16.2,
      "text": "OH, IT'S IN! From halfway! Marshall was stranded!"
    },
    {
      "t": 17.6,
      "text": "Forty-five metres. The longest goal the tournament has ever seen."
    }
  ],
