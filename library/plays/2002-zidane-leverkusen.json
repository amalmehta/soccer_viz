  "analysis": [
    {
      "label": "Context",
      "text": "Level at 1–1 just before half-time in the Champions League final. Solari carried the ball down the left and released Roberto Carlos towards the touchline."
    },
    {
      "label": "The delivery",
      "text": "Roberto Carlos reached it near the touchline and hooked a high, looping ball towards the edge of the box. It was a hopeful delivery, dropping steeply rather than arriving at pace."
    },
    {
      "label": "The technique",
      "text": "Zidane stepped away from the marker, watched the ball drop over the left shoulder and met it first time with the weaker left foot, staying over the ball so the volley stayed down and on target."
    },
    {
      "label": "The finish",
      "text": "Struck on the drop with no set-up touch, the volley flew into the top corner before Butt could move across. A steeply falling ball is very hard to hit cleanly, which is what made the contact so remarkable."
    }
  ],
  "captions": [
    {
      "t": 0,
      "text": "Level at 1–1 just before half-time."
    },
    {
      "t": 1.4,
      "text": "Solari carries it forward down the left side."
    },
    {
      "t": 4,
      "text": "Roberto Carlos races onto the ball near the touchline."
    },
    {
      "t": 5.7,
      "text": "Carlos hooks a high, looping ball towards the edge of the box."
    },
    {
      "t": 6.6,
      "text": "Zidane waits for it to drop over the left shoulder."
    },
    {
      "t": 7.2,
      "text": "Left-foot volley, first time."
    },
    {
      "t": 7.8,
      "text": "Into the top corner. Butt has no chance."
    },
    {
