  "commentary": [
    {
      "t": 0,
      "text": "Almost half-time at Hampden, and it's still all square."
    },
    {
      "t": 1.4,
      "text": "Solari looking to spring Roberto Carlos down the left…"
    },
    {
      "t": 4,
      "text": "Carlos will get there first…"
    },
    {
      "t": 5.7,
      "text": "Carlos just helps it up into the air — it's a hopeful one…"
    },
    {
      "t": 6.6,
      "text": "Zidane has stepped away from the marker, waiting for it…"
    },
    {
      "t": 7.2,
      "text": "ZIDANE!"
    },
    {
      "t": 7.8,
      "text": "OH, WHAT A GOAL! Straight into the top corner!"
    },
    {
      "t": 9.1,
      "text": "The ball fell out of the sky and Zidane struck it perfectly!"
    },
    {
      "t": 10.2,
      "text": "A final worthy of that finish."
    }
