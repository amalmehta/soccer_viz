  "captions": [
    {
      "t": 0,
      "text": "57' — Argentina lead 2–1 and France need a way back in."
    },
    {
      "t": 5.5,
      "text": "Kanté carries it out of midfield."
    },
    {
      "t": 10.6,
      "text": "Matuidi takes it on down the left."
    },
    {
      "t": 15.4,
      "text": "Hernández crosses, but the header only clears it."
    },
    {
      "t": 17.3,
      "text": "It drops to Pavard, 20 metres out and side on."
    },
    {
      "t": 17.9,
      "text": "Right foot, first time, across the ball."
    },
    {
      "t": 19.1,
      "text": "Far corner. France 2–2 Argentina."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Fifty-seven minutes in Kazan, Argentina in front, and France need something."
    },
    {
      "t": 5.5,
      "text": "Kanté wins it and drives out of midfield…"
    },
    {
      "t": 10.6,
      "text": "…into Matuidi, who takes it down the left."
    },
    {
      "t": 15.4,
      "text": "The cross comes in, and it's headed clear, only as far as the edge…"
    },
    {
      "t": 17.3,
      "text": "…Pavard, side on, 20 yards out…"
    },
    {
      "t": 17.9,
      "text": "…struck first time!"
    },
    {
      "t": 19.12,
      "text": "OH, THAT IS GLORIOUS! Curling away into the far corner! Two apiece!"
    },
    {
      "t": 20.6,
      "text": "A full-back, off the weaker side, with the goal of the tournament."
    }
  ],
