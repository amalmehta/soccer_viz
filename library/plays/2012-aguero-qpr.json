  "captions": [
    {
      "t": 0,
      "text": "90+4', 2–2. City need a winner to take the title."
    },
    {
      "t": 1.5,
      "text": "De Jong drives forward and finds Agüero."
    },
    {
      "t": 4.2,
      "text": "Agüero plays it into Balotelli on the edge of the box…"
    },
    {
      "t": 5.4,
      "text": "…Balotelli, going down, pokes it back into Agüero's path."
    },
    {
      "t": 6.6,
      "text": "Agüero goes past Taiwo's challenge…"
    },
    {
      "t": 8.2,
      "text": "…and drills it in at the near post, past Kenny."
    },
    {
      "t": 8.65,
      "text": "City 3–2 QPR. Champions on goal difference."
    }
