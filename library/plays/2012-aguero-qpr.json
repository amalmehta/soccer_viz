  "commentary": [
    {
      "t": 0,
      "text": "Deep into stoppage time at the Etihad. City need one more…"
    },
    {
      "t": 1.2,
      "text": "De Jong carries it into the QPR half."
    },
    {
      "t": 3.6,
      "text": "Agüero… looks inside, gives it to Balotelli."
    },
    {
      "t": 5.4,
      "text": "Balotelli's stumbling, but it's pushed back to Agüero!"
    },
    {
      "t": 6.8,
      "text": "Agüero's through the challenge, into the box!"
    },
    {
      "t": 8.2,
      "text": "Agüero shoots—"
    },
    {
      "t": 8.65,
      "text": "IT'S IN! City have found the winner! Unbelievable scenes!"
    },
    {
      "t": 10,
      "text": "The whole stadium is shaking. Forty-four years of waiting, over."
    }
  ],
