  "captions": [
    {
      "t": 0,
      "text": "55' — Argentina lead England 1–0 in the quarter-final."
    },
    {
      "t": 2.4,
      "text": "Cuciuffo finds Enrique, deep in the Argentina half."
    },
    {
      "t": 4.4,
      "text": "Enrique's pass reaches Maradona, back to goal."
    },
    {
      "t": 5.8,
      "text": "One turn beats Beardsley and Reid together."
    },
    {
      "t": 8.7,
      "text": "Into England's half at full speed, down the right."
    },
    {
      "t": 11.5,
      "text": "Butcher comes across and is beaten."
    },
    {
      "t": 13.5,
      "text": "Fenwick can't get a tackle in either."
    },
    {
      "t": 15.7,
      "text": "Round Shilton, and rolled in as Butcher slides."
    },
    {
      "t": 17.2,
      "text": "Argentina 2–0 England."
    }
  ],
  "commentary": [
    {
      "t": 0,
      "text": "Fifty-five minutes at the Azteca, Argentina a goal up and playing it around at the back."
    },
    {
      "t": 2.4,
      "text": "Cuciuffo, square to Enrique…"
    },
    {
      "t": 4.4,
      "text": "…and it's rolled into Maradona, back to goal, inside the Argentina half."
    },
    {
      "t": 5.7,
      "text": "One turn, and two England shirts are beaten at once!"
    },
    {
      "t": 8.6,
      "text": "Away goes the number ten, and nobody is getting near."
    },
    {
      "t": 11.4,
      "text": "Butcher comes across — beaten as well!"
    },
    {
      "t": 13.4,
      "text": "Fenwick next, and Fenwick can't stop it either!"
    },
    {
      "t": 15.6,
      "text": "Round Shilton…"
    },
    {
      "t": 16.35,
      "text": "…IT'S IN! All the way from the Argentina half, alone. Extraordinary."
    }
  ],
