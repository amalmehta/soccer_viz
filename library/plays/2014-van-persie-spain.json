    {
      "t": 0,
      "text": "44' — Spain lead 1–0 through Xabi Alonso's penalty."
    },
    {
      "t": 2.2,
      "text": "The Dutch move it across from the back."
    },
    {
      "t": 4.4,
      "text": "Blind picks it up out on the left."
    },
    {
      "t": 5.6,
      "text": "One long diagonal ball from deep…"
    },
    {
      "t": 7,
      "text": "Van Persie is on the run and Casillas is off the line."
    },
    {
      "t": 8.3,
      "text": "A full-length dive, heading it up over the keeper."
    },
    {
      "t": 9.7,
      "text": "It loops in. Spain 1–1 Netherlands."
    }
