  "commentary": [
    {
      "t": 0,
      "text": "Nearly half-time in Salvador, and the champions are in front."
    },
    {
      "t": 2.2,
      "text": "The Netherlands probing from the back."
    },
    {
      "t": 4.4,
      "text": "Blind, with a bit of time on the left…"
    },
    {
      "t": 5.6,
      "text": "Blind looks up and sends it long for van Persie!"
    },
    {
      "t": 7.4,
      "text": "Casillas is coming for it…"
    },
    {
      "t": 8.3,
      "text": "Van Persie dives full length at it!"
    },
    {
      "t": 9.7,
      "text": "IT'S IN! A flying header, right over the keeper! Stunning!"
    },
    {
      "t": 11,
      "text": "Level just before the break, and what a way to do it."
    }
  ],
